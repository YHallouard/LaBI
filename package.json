{
  "name": "hemea",
  "version": "1.5.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --collect-coverage",
    "prepare": "husky",
    "lint": "npx eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\" --fix",
    "format": "npx prettier --write \"{src,apps,libs,test}/**/*.{ts,tsx,json}\"",
    "lint-staged": "npx lint-staged",
    "mutation": "npx stryker run",
    "mutation:file": "npx stryker run --mutate",
    "postinstall": "patch-package",
    "sync-version": "node scripts/sync-version.js",
    "prebuild": "npm run sync-version",
    "fix-xcode": "node ios-scripts/xcode-project-fix.js",
    "ios-build": "node ios-scripts/xcode-project-fix.js && npm run ios",
    "prepare-testflight": "node ios-scripts/prepare-testflight.js"
  },
  "dependencies": {
    "@ai-sdk/mistral": "3.0.36",
    "@expo/vector-icons": "^15.0.3",
    "@mistralai/mistralai": "^1.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/stack": "^7.2.10",
    "@types/uuid": "^10.0.0",
    "ai": "6.0.177",
    "buffer": "6.0.3",
    "expo": "54.0.34",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-is": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-location-enabler": "2.0.1",
    "react-native-ble-manager": "12.1.4",
    "react-native-ble-plx": "3.5.0",
    "react-native-device-info": "14.0.4",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.60",
    "react-native-multipeer-connectivity": "0.1.0",
    "react-native-permissions": "5.4.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sqlcipher-storage": "0.0.3",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "1.6.3",
    "react-navigation-header-buttons": "13.0.0",
    "uuid": "^11.1.0",
    "web-streams-polyfill": "^4.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "9.26.0",
    "@react-native-community/cli": "latest",
    "@stryker-mutator/core": "^7.3.0",
    "@stryker-mutator/jest-runner": "^7.3.0",
    "@stryker-mutator/typescript-checker": "^7.3.0",
    "@testing-library/react-native": "13.3.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "babel-plugin-transform-remove-console": "6.9.4",
    "eslint": "9.26.0",
    "eslint-plugin-react": "7.37.5",
    "expo-build-properties": "~1.0.10",
    "globals": "16.0.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "patch-package": "^8.0.0",
    "prettier": "^2.0.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.3.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.31.1"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
