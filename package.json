{
  "name": "hemea",
  "version": "1.5.0",
  "main": "expo-router/entry",
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --collect-coverage",
    "prepare": "husky",
    "lint": "npx eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\" --fix",
    "format": "npx prettier --write \"{src,apps,libs,test}/**/*.{ts,tsx,json}\"",
    "lint-staged": "npx lint-staged",
    "mutation": "npx stryker run",
    "mutation:file": "npx stryker run --mutate",
    "postinstall": "patch-package",
    "sync-version": "node scripts/sync-version.js",
    "prebuild": "npm run sync-version",
    "fix-xcode": "node ios-scripts/xcode-project-fix.js",
    "ios-build": "node ios-scripts/xcode-project-fix.js && npm run ios",
    "prepare-testflight": "node ios-scripts/prepare-testflight.js"
  },
  "dependencies": {
    "@ai-sdk/mistral": "3.0.36",
    "@expo/ui": "56.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@mistralai/mistralai": "^1.6.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/stack": "^7.2.10",
    "ai": "6.0.177",
    "buffer": "6.0.3",
    "expo": "56.0.5",
    "expo-blur": "~56.0.3",
    "expo-linking": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image-picker": "~56.0.14",
    "expo-linear-gradient": "~56.0.4",
    "expo-router": "~56.2.7",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.14",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "6.4.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "react-native-zeroconf": "0.14.0",
    "uuid": "^11.1.0",
    "web-streams-polyfill": "^4.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.85.3",
    "@stryker-mutator/core": "^7.3.0",
    "@stryker-mutator/jest-runner": "^7.3.0",
    "@stryker-mutator/typescript-checker": "^7.3.0",
    "@testing-library/react-native": "13.3.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.14",
    "@types/uuid": "^10.0.0",
    "babel-plugin-transform-remove-console": "6.9.4",
    "eslint": "9.26.0",
    "eslint-plugin-react": "7.37.5",
    "expo-build-properties": "~56.0.15",
    "globals": "16.0.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "patch-package": "^8.0.0",
    "prettier": "^2.0.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.31.1"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
